        // Bootstrap core JS
        script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js')

        // Third party plugin JS
        script(src='https://cdnjs.cloudflare.com/ajax/libs/jquery-easing/1.4.1/jquery.easing.min.js')
        script(src='https://www.amcharts.com/lib/4/core.js')
        script(src='https://www.amcharts.com/lib/4/maps.js')
        script(src='https://www.amcharts.com/lib/4/geodata/worldLow.js')
        script(src='https://www.amcharts.com/lib/4/geodata/usaLow.js')
        script(src='https://www.amcharts.com/lib/4/themes/animated.js')

        // Core theme JS
        script(src='js/scripts.js')

        script.
            document.addEventListener('DOMContentLoaded', function() {
                const showMoreBtn = document.getElementById('show-more-btn');
                const hiddenUpdates = document.querySelectorAll('.more-updates');

                // Dark mode toggle
                const darkBtn = document.getElementById('dark-mode-toggle');
                const darkIcon = darkBtn.querySelector('i');
                const navLogo = document.getElementById('nav-logo');
                const setLogo = (isDark) => {
                    if (navLogo) navLogo.src = isDark ? 'assets/img/SK-black.png' : 'assets/img/SK.png';
                };
                if (localStorage.getItem('darkMode') === 'on') {
                    document.body.classList.add('dark-mode');
                    darkIcon.classList.replace('fa-moon', 'fa-sun');
                    darkBtn.childNodes[darkBtn.childNodes.length - 1].textContent = ' Light Mode';
                    setLogo(true);
                }
                darkBtn.addEventListener('click', () => {
                    const isDark = document.body.classList.toggle('dark-mode');
                    darkIcon.classList.toggle('fa-moon', !isDark);
                    darkIcon.classList.toggle('fa-sun', isDark);
                    darkBtn.childNodes[darkBtn.childNodes.length - 1].textContent = isDark ? ' Light Mode' : ' Dark Mode';
                    localStorage.setItem('darkMode', isDark ? 'on' : 'off');
                    setLogo(isDark);
                });

                // Publication filter
                const filterBtns = document.querySelectorAll('.btn-filter');
                const pubItems = document.querySelectorAll('.pub-item');
                filterBtns.forEach(btn => {
                    btn.addEventListener('click', () => {
                        filterBtns.forEach(b => b.classList.remove('active'));
                        btn.classList.add('active');
                        const filter = btn.dataset.filter;
                        pubItems.forEach(item => {
                            item.style.display = (filter === 'all' || item.dataset.category === filter) ? '' : 'none';
                        });
                    });
                });

                showMoreBtn.addEventListener('click', function(event) {
                event.preventDefault(); // Prevents the link from jumping to the top of the page

                // Toggle the display of each hidden item
                hiddenUpdates.forEach(item => {
                    if (item.style.display === 'none' || item.style.display === '') {
                    item.style.display = 'list-item';
                    } else {
                    item.style.display = 'none';
                    }
                });

                // Change the button text
                if (this.innerText === 'Show More Updates') {
                    this.innerText = 'Show Less';
                } else {
                    this.innerText = 'Show More Updates';
                }
                });
            });

            function copyBibTeX(btn) {
                var item = btn.closest('.pub-item');
                var ta = item.querySelector('.bibtex-data');
                if (!ta) return;
                var text = ta.value.trim();
                navigator.clipboard.writeText(text).then(function() {
                    var origHTML = btn.innerHTML;
                    btn.textContent = 'Copied!';
                    setTimeout(function() { btn.innerHTML = origHTML; }, 2000);
                }).catch(function() {
                    ta.select();
                    document.execCommand('copy');
                });
            }